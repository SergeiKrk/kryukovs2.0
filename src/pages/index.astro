  <script>
  const prepareJourneyMotion = () => {
    const board = document.querySelector<HTMLElement>(".journey-board");
    if (!board || board.dataset.motionReady === "true") return;

    board.dataset.motionReady = "true";
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
      board.classList.add("is-visible");
      return;
    }

    board.classList.add("journey-motion");
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry?.isIntersecting) return;
      board.classList.add("is-visible");
      window.setTimeout(() => board.classList.add("journey-settled"), 1550);
      observer.disconnect();
    }, { threshold: 0.2 });

    observer.observe(board);
  };

  prepareJourneyMotion();
  document.addEventListener("astro:page-load", prepareJourneyMotion);
  </script>
