---
import ProjectCalculator from "./ProjectCalculator";
---

<dialog id="calculator" class="v3-calculator-dialog" aria-label="Калькулятор проекта" data-lenis-prevent>
  <ProjectCalculator client:load />
</dialog>

<script>
  const calculatorDialog = document.querySelector<HTMLDialogElement>("#calculator");
  let previousHtmlOverflow = "";
  let previousBodyOverflow = "";
  const openCalculator = (event: Event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const trigger = target.closest("[data-v3-open-calculator]");
    if (!trigger || !calculatorDialog || calculatorDialog.open) return;
    event.preventDefault();
    previousHtmlOverflow = document.documentElement.style.overflow;
    previousBodyOverflow = document.body.style.overflow;
    document.documentElement.style.overflow = "hidden";
    document.body.style.overflow = "hidden";
    calculatorDialog.showModal();
    window.dispatchEvent(new Event("v3:modal-open"));
    calculatorDialog.scrollTop = 0;
    requestAnimationFrame(() => calculatorDialog.querySelector<HTMLElement>(".v3-calculator")?.focus({ preventScroll: true }));
  };
  const restorePageScroll = () => {
    document.documentElement.style.overflow = previousHtmlOverflow;
    document.body.style.overflow = previousBodyOverflow;
    window.dispatchEvent(new Event("v3:modal-close"));
  };

  document.addEventListener("click", openCalculator);
  calculatorDialog?.addEventListener("click", (event) => {
    if (event.target === calculatorDialog) calculatorDialog.close();
  });
  calculatorDialog?.addEventListener("close", restorePageScroll);
</script>
