---
import "lenis/dist/lenis.css";
---

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { MotionPathPlugin } from "gsap/MotionPathPlugin";
  import Lenis from "lenis";
  import {
    getHorizontalTravel,
    readMotionEvent,
    resolveMotionEnabled,
  } from "./v3MotionHelpers.mjs";

  gsap.registerPlugin(ScrollTrigger, SplitText, MotionPathPlugin);

  const CINEMATIC_QUERY = "(min-width: 900px) and (min-height: 650px) and (pointer: fine) and (prefers-reduced-motion: no-preference)";
  const REDUCED_QUERY = "(prefers-reduced-motion: reduce)";
  const letterPresets = [
    { xPercent: -148, yPercent: -110, rotation: -24 },
    { xPercent: 106, yPercent: -138, rotation: 21 },
    { xPercent: -72, yPercent: 154, rotation: 18 },
    { xPercent: 158, yPercent: 88, rotation: -20 },
    { xPercent: 28, yPercent: -168, rotation: 14 },
    { xPercent: -132, yPercent: 72, rotation: 23 },
  ] as const;

  type Cleanup = () => void;
  type NetworkInformation = { saveData?: boolean };

  let motionOverride: boolean | null = null;

  function getSavedPreference() {
    try {
      return sessionStorage.getItem("v3-motion");
    } catch {
      return null;
    }
  }

  function setWillChange(elements: Element[], value: string) {
    elements.forEach((element) => {
      if (element instanceof HTMLElement || element instanceof SVGElement) {
        element.style.willChange = value;
      }
    });
  }

  function waitForImage(image: HTMLImageElement, disposers: Cleanup[]) {
    if (image.complete) {
      return typeof image.decode === "function" ? image.decode().catch(() => undefined) : Promise.resolve();
    }
    return new Promise<void>((resolve) => {
      const settle = () => resolve();
      image.addEventListener("load", settle, { once: true });
      image.addEventListener("error", settle, { once: true });
      disposers.push(() => {
        image.removeEventListener("load", settle);
        image.removeEventListener("error", settle);
      });
    });
  }

  function initV3Motion(root: HTMLElement): Cleanup {
    const reducedMotion = window.matchMedia(REDUCED_QUERY).matches;
    const enabled = motionOverride ?? resolveMotionEnabled(getSavedPreference(), reducedMotion);
    const disposers: Cleanup[] = [];
    const media = gsap.matchMedia();
    let disposed = false;
    let resizeTimer: number | undefined;

    root.dataset.v3Motion = enabled ? "on" : "off";

    const context = gsap.context(() => {
      if (!enabled) {
        const copy = root.querySelector<HTMLElement>("[data-v3-capabilities-copy]");
        if (copy) gsap.set(copy, { autoAlpha: 1, clearProps: "filter,transform" });
        return;
      }

      media.add(CINEMATIC_QUERY, () => {
        root.classList.add("v3-motion-cinematic");

        let lenis: Lenis | undefined;
        let ticker: ((time: number) => void) | undefined;
        const branchDisposers: Cleanup[] = [];

        lenis = new Lenis({
          autoRaf: false,
          lerp: 0.085,
          smoothWheel: true,
          anchors: { offset: -84 },
        });
        lenis.on("scroll", ScrollTrigger.update);
        ticker = (time) => lenis?.raf(time * 1000);
        gsap.ticker.add(ticker);

        const hero = root.querySelector<HTMLElement>(".v3-hero");
        const heroCopy = root.querySelector<HTMLElement>("[data-v3-hero-copy]");
        const heroTitle = root.querySelector<HTMLElement>("[data-v3-hero-title]");
        const titleText = root.querySelector<HTMLElement>(".v3-hero__title-outline");
        const heroVisual = root.querySelector<HTMLElement>("[data-v3-hero-visual]");
        const heroLaptop = root.querySelector<HTMLImageElement>("[data-v3-hero-laptop]");
        const heroHead = root.querySelector<HTMLImageElement>("[data-v3-hero-head]");
        const heroRocks = Array.from(root.querySelectorAll<HTMLElement>("[data-v3-hero-rock]"));
        const introElements = [heroTitle, heroLaptop, heroHead].filter(Boolean) as Element[];
        const heroAnimated = [heroCopy, heroVisual].filter(Boolean) as Element[];

        if (heroTitle && titleText && heroLaptop && heroHead) {
          const titleSplit = new SplitText(titleText, { type: "lines,words,chars", linesClass: "v3-title-line" });
          branchDisposers.push(() => titleSplit.revert());
          setWillChange(introElements, "transform, opacity");
          gsap.timeline({
            defaults: { ease: "power3.out" },
            onComplete: () => setWillChange(introElements, ""),
          })
            .fromTo(titleSplit.chars, { autoAlpha: 0, yPercent: 115, rotateX: -75 }, { autoAlpha: 1, yPercent: 0, rotateX: 0, duration: 0.52, stagger: 0.018 }, 0)
            .fromTo(heroLaptop, { autoAlpha: 0, xPercent: -34 }, { autoAlpha: 1, xPercent: 0, duration: 0.72 }, 0.5)
            .fromTo(heroHead, { autoAlpha: 0, xPercent: 36 }, { autoAlpha: 1, xPercent: 0, duration: 0.78 }, 0.5);

          gsap.to(heroLaptop, { y: -10, duration: 2.8, ease: "sine.inOut", repeat: -1, yoyo: true, delay: 1.2 });
          const rotateHead = gsap.quickTo(heroHead, "rotation", { duration: 0.45, ease: "power2.out" });
          const onPointerMove = (event: PointerEvent) => {
            const ratio = event.clientX / Math.max(1, window.innerWidth);
            rotateHead(-10 + ratio * 10);
          };
          window.addEventListener("pointermove", onPointerMove, { passive: true });
          branchDisposers.push(() => window.removeEventListener("pointermove", onPointerMove));
        }

        if (hero && heroRocks.length) {
          heroRocks.forEach((rock, index) => {
            const image = rock.querySelector("img");
            const depth = (index % 3) + 1;
            gsap.to(image, {
              y: index % 2 ? 12 + depth * 3 : -12 - depth * 3,
              rotation: index % 2 ? 4 : -4,
              duration: 3.2 + index * 0.38,
              ease: "sine.inOut",
              repeat: -1,
              yoyo: true,
            });
            gsap.to(rock, {
              yPercent: 38 + depth * 22,
              ease: "none",
              scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: 0.8 },
            });
          });

          const pointerDepth = [
            { x: -8, y: -5 },
            { x: 24, y: 14 },
            { x: -13, y: 9 },
            { x: 46, y: 28 },
            { x: -30, y: -17 },
            { x: 11, y: -8 },
          ];
          const rockX = heroRocks.map((rock, index) => gsap.quickTo(rock, "x", { duration: 0.62 + index * 0.1, ease: "power2.out" }));
          const rockY = heroRocks.map((rock, index) => gsap.quickTo(rock, "y", { duration: 0.72 + index * 0.1, ease: "power2.out" }));
          const moveRocks = (event: PointerEvent) => {
            const x = event.clientX / Math.max(1, window.innerWidth) - 0.5;
            const y = event.clientY / Math.max(1, window.innerHeight) - 0.5;
            heroRocks.forEach((_, index) => {
              const movement = pointerDepth[index] ?? pointerDepth[0];
              rockX[index](x * movement.x);
              rockY[index](y * movement.y);
            });
          };
          window.addEventListener("pointermove", moveRocks, { passive: true });
          branchDisposers.push(() => window.removeEventListener("pointermove", moveRocks));
        }

        if (hero && heroCopy && heroVisual) {
          gsap.timeline({
            onReverseComplete: () => gsap.set(heroHead, { autoAlpha: 1, yPercent: 0, scale: 1 }),
            scrollTrigger: {
              trigger: hero,
              start: "top top",
              end: () => `+=${Math.max(520, window.innerHeight * 0.82)}`,
              scrub: 0.7,
              invalidateOnRefresh: true,
              onEnter: () => setWillChange(heroAnimated, "transform, opacity"),
              onEnterBack: () => {
                setWillChange(heroAnimated, "transform, opacity");
                gsap.set(heroHead, { autoAlpha: 1, x: 0, xPercent: 0, y: 0, yPercent: 0, scale: 1, rotation: 0 });
              },
              onLeave: () => setWillChange(heroAnimated, ""),
              onLeaveBack: () => {
                setWillChange(heroAnimated, "");
                gsap.set(heroHead, { autoAlpha: 1, x: 0, xPercent: 0, y: 0, yPercent: 0, scale: 1, rotation: 0 });
              },
            },
          })
            .to(heroCopy, { yPercent: -26, autoAlpha: 0.28, ease: "none" }, 0)
            .to(heroVisual, { yPercent: -9, scale: 1.035, ease: "none" }, 0)
            .to(heroLaptop, { yPercent: -18, xPercent: -5, ease: "none" }, 0)
            .to(heroHead, { yPercent: 22, scale: 0.72, autoAlpha: 0, ease: "power1.inOut" }, 0.18);
        }

        const capabilitiesSection = root.querySelector<HTMLElement>("[data-v3-capabilities]");
        const capabilityLetters = Array.from(root.querySelectorAll<HTMLElement>("[data-v3-stone-letter]"));
        const capabilityWords = Array.from(root.querySelectorAll<HTMLElement>("[data-v3-capability]"));
        const capabilityCopy = root.querySelector<HTMLElement>("[data-v3-capabilities-copy]");
        const capabilityStage = root.querySelector<HTMLElement>("[data-v3-capabilities-stage]");
        const capabilityHead = root.querySelector<HTMLElement>("[data-v3-capabilities-head]");
        const capabilityPin = root.querySelector<HTMLElement>("[data-v3-capabilities-pin]");
        const capabilityRocks = Array.from(root.querySelectorAll<HTMLElement>("[data-v3-capabilities-rock]"));
        const ringSeparators = Array.from(root.querySelectorAll<HTMLElement>("[data-v3-ring-separator]"));
        const ringPath = root.querySelector<SVGPathElement>("[data-v3-capabilities-ring-path]");
        if (capabilitiesSection && capabilityStage && capabilityPin) {
          capabilityLetters.forEach((letter, index) => {
            const preset = letterPresets[index % letterPresets.length];
            gsap.set(letter, { xPercent: preset.xPercent * 1.65, yPercent: preset.yPercent * 1.65, rotation: preset.rotation * 1.4, autoAlpha: 0, scale: 0.58 + (index % 3) * 0.1 });
          });
          gsap.set(capabilityCopy, { autoAlpha: 0, y: 40, filter: "blur(10px)" });
          gsap.set(capabilityHead, { autoAlpha: 0, scale: 0.7 });
          gsap.set(ringSeparators, { autoAlpha: 0, scale: 0.6 });
          gsap.set(capabilityRocks, {
            autoAlpha: 0,
            scale: (index) => [0.62, 0.9, 1.18][index % 3],
          });
          const headFloat = capabilityHead
            ? gsap.to(capabilityHead, { y: 9, duration: 2.5, repeat: -1, yoyo: true, ease: "sine.inOut", paused: true })
            : undefined;
          let ringActive = false;
          const ringTweens: gsap.core.Tween[] = [];
          const ringItems = capabilityWords.flatMap((word, groupIndex) => {
            const letters = Array.from(word.querySelectorAll<HTMLElement>("[data-v3-stone-letter]"));
            const separator = ringSeparators[groupIndex];
            return separator ? [...letters, separator] : letters;
          });
          const setRingMode = (active: boolean) => {
            if (ringActive === active) return;
            ringActive = active;
            capabilitiesSection.classList.toggle("is-ring", active);
            if (!active) {
              ringTweens.forEach((tween) => tween.kill());
              ringTweens.length = 0;
              gsap.set(ringSeparators, { autoAlpha: 0 });
              return;
            }
            ringItems.forEach((item, index) => {
              const phase = index / Math.max(1, ringItems.length);
              gsap.set(item, { clearProps: "transform", autoAlpha: 0, x: 0, y: 0, xPercent: -50, yPercent: -50, rotation: phase * 360, scale: 0.25 });
              const fadeTween = gsap.to(item, { autoAlpha: 1, duration: 0.5, delay: index * 0.015, ease: "power2.out" });
              ringTweens.push(fadeTween);
              if (!ringPath) return;
              const tween = gsap.to(item, {
                duration: 24,
                repeat: -1,
                ease: "none",
                scale: 0.25,
                motionPath: {
                  path: ringPath,
                  align: ringPath,
                  alignOrigin: [0.5, 0.5],
                  start: index / Math.max(1, ringItems.length),
                  end: -1 + index / Math.max(1, ringItems.length),
                },
                onUpdate: function () {
                  gsap.set(item, { rotation: (phase - this.progress()) * 360, scale: 0.25 });
                },
              });
              ringTweens.push(tween);
            });
          };
          const reverseCapabilities = () => {
            setRingMode(false);
            headFloat?.pause();
            capabilitiesSection.classList.remove("is-ring");
            gsap.to(capabilityStage, { x: 0, y: 0, xPercent: 0, yPercent: 0, scale: 1, rotation: 0, autoAlpha: 1, duration: 0.58, ease: "power2.out" });
            gsap.to(capabilityLetters, {
              x: 0,
              y: 0,
              xPercent: 0,
              yPercent: 0,
              rotation: 0,
              scale: 1,
              autoAlpha: 1,
              duration: 0.58,
              stagger: 0.018,
              ease: "power2.out",
            });
            gsap.to(capabilityRocks, {
              x: 0,
              y: 0,
              xPercent: 0,
              yPercent: 0,
              autoAlpha: (index) => [0.16, 0.24, 0.34][index % 3],
              scale: (index) => [0.62, 0.9, 1.18][index % 3],
              duration: 0.52,
              stagger: 0.012,
              ease: "power2.out",
            });
            gsap.to(ringSeparators, { x: 0, y: 0, xPercent: 0, yPercent: 0, rotation: 0, scale: 0.6, autoAlpha: 0, duration: 0.4, ease: "power2.out" });
            gsap.to(capabilityHead, { x: 0, y: 0, rotation: 0, autoAlpha: 0, scale: 0.7, duration: 0.45, ease: "power2.out" });
            gsap.to(capabilityCopy, { autoAlpha: 0, y: 40, filter: "blur(10px)", duration: 0.4, ease: "power2.out" });
          };
          const prepareCapabilitiesEntry = () => {
            setRingMode(false);
            headFloat?.pause(0);
            capabilitiesSection.classList.remove("is-ring");
            gsap.set(capabilityStage, { x: 0, y: 0, xPercent: 0, yPercent: 0, scale: 1, rotation: 0, autoAlpha: 1 });
            gsap.set(capabilityLetters, {
              x: 0,
              y: 0,
              xPercent: (index) => letterPresets[index % letterPresets.length].xPercent * 1.65,
              yPercent: (index) => letterPresets[index % letterPresets.length].yPercent * 1.65,
              rotation: (index) => letterPresets[index % letterPresets.length].rotation * 1.4,
              scale: (index) => 0.58 + (index % 3) * 0.1,
              autoAlpha: 0,
            });
            gsap.set(capabilityRocks, { x: 0, y: 0, xPercent: 0, yPercent: 0, autoAlpha: 0, scale: (index) => [0.62, 0.9, 1.18][index % 3] });
            gsap.set(ringSeparators, { x: 0, y: 0, xPercent: 0, yPercent: 0, rotation: 0, scale: 0.6, autoAlpha: 0 });
            gsap.set(capabilityHead, { x: 0, y: 0, rotation: 0, autoAlpha: 0, scale: 0.7 });
            gsap.set(capabilityCopy, { autoAlpha: 0, y: 40, filter: "blur(10px)" });
          };
          let suppressReverseScene = false;
          const scene = gsap.timeline({
            scrollTrigger: {
              trigger: capabilitiesSection,
              start: "top top+=76",
              end: () => `+=${Math.max(window.innerHeight * 4.8, 3600)}`,
              scrub: 0.65,
              pin: capabilityPin,
              anticipatePin: 1,
              invalidateOnRefresh: true,
              onUpdate: (self) => {
                if (self.direction === -1 && self.progress < 0.99) {
                  if (!suppressReverseScene) {
                    suppressReverseScene = true;
                    reverseCapabilities();
                  }
                  return;
                }
                if (self.direction === 1) suppressReverseScene = false;
                if (suppressReverseScene) return;
                if (self.progress > 0.91) headFloat?.play();
                else headFloat?.pause();
                if (self.progress > 0.78) setRingMode(true);
                else setRingMode(false);
              },
              onEnter: () => {
                suppressReverseScene = false;
                prepareCapabilitiesEntry();
              },
              onLeaveBack: prepareCapabilitiesEntry,
            },
          });
          scene.addLabel("enter")
            .to(capabilityRocks, { autoAlpha: (i) => [0.32, 0.52, 0.76][i % 3], duration: 0.65, stagger: 0.025, ease: "power2.out" }, "enter")
            .to(capabilityRocks, { yPercent: (i) => (i % 2 ? -28 : 24), xPercent: (i) => (i % 3 - 1) * 18, duration: 2.4, ease: "none" }, "enter")
            .fromTo(capabilityLetters,
              {
                xPercent: (index) => letterPresets[index % letterPresets.length].xPercent * 1.65,
                yPercent: (index) => letterPresets[index % letterPresets.length].yPercent * 1.65,
                rotation: (index) => letterPresets[index % letterPresets.length].rotation * 1.4,
                scale: (index) => 0.58 + (index % 3) * 0.1,
                autoAlpha: 0,
              },
              { xPercent: 0, yPercent: 0, rotation: 0, scale: 1, autoAlpha: 1, stagger: { each: 0.04, from: "random" }, ease: "power3.out", duration: 1.8 },
              "enter+=0.15")
            .addLabel("words")
            .to({}, { duration: 0.75 }, "words")
            .addLabel("flow")
            .to(capabilityLetters, { x: (i) => Math.sin(i * 1.3) * 150, y: (i) => Math.cos(i * 1.6) * 110, rotation: (i) => (i % 2 ? 42 : -38), scale: 0.22, autoAlpha: 0, duration: 1.15, stagger: { each: 0.018, from: "random" }, ease: "power2.inOut" }, "flow")
            .to(capabilityRocks, { autoAlpha: 0, scale: (i) => [0.42, 0.58, 0.76][i % 3], duration: 0.8, stagger: 0.012, ease: "power2.in" }, "flow+=0.18")
            .to(capabilityStage, { xPercent: 23, scale: 0.64, duration: 1.05, ease: "power3.inOut" }, "flow+=0.35")
            .to(capabilityRocks, { xPercent: -23, duration: 1.05, ease: "power3.inOut" }, "flow+=0.35")
            .set(capabilityLetters, { x: 0, y: 0, xPercent: 0, yPercent: 0, rotation: 0, scale: 1 }, "flow+=1.48")
            .to(capabilityHead, { autoAlpha: 1, scale: 1, duration: 0.7, ease: "back.out(1.35)" }, "flow+=1.5")
            .fromTo(capabilityCopy, { autoAlpha: 0, y: 40, filter: "blur(10px)" }, { autoAlpha: 1, y: 0, filter: "blur(0px)", duration: 0.65, ease: "power2.out" }, "flow+=1.62")
            .to({}, { duration: 0.55 });

          if (window.matchMedia("(pointer: fine)").matches) {
            const strengths = [5, 15, 30];
            const rockX = capabilityRocks.map((rock) => gsap.quickTo(rock, "x", { duration: 0.75, ease: "power3.out" }));
            const rockY = capabilityRocks.map((rock) => gsap.quickTo(rock, "y", { duration: 0.75, ease: "power3.out" }));
            const moveCapabilityRocks = (event: PointerEvent) => {
              const nx = event.clientX / window.innerWidth - 0.5;
              const ny = event.clientY / window.innerHeight - 0.5;
              capabilityRocks.forEach((rock, index) => {
                const strength = strengths[(Number(rock.dataset.depth) || 1) - 1];
                rockX[index](nx * strength * (index % 2 ? -1 : 1));
                rockY[index](ny * strength * (index % 3 ? 1 : -1));
              });
            };
            window.addEventListener("pointermove", moveCapabilityRocks, { passive: true });
            branchDisposers.push(() => window.removeEventListener("pointermove", moveCapabilityRocks));
          }
          branchDisposers.push(() => {
            headFloat?.kill();
            ringTweens.forEach((tween) => tween.kill());
            capabilitiesSection.classList.remove("is-ring");
          });
        }

        const identityStage = root.querySelector<HTMLElement>("[data-v3-identity-stage]");
        const identityHead = root.querySelector<HTMLImageElement>("[data-v3-identity-head]");
        const identityVideo = root.querySelector<HTMLImageElement>("[data-v3-identity-video]");
        const identityFinal = root.querySelector<HTMLImageElement>("[data-v3-identity-final]");
        const identityCopy = root.querySelector<HTMLElement>(".v3-personal__copy");
        const identitySignature = root.querySelector<HTMLElement>("[data-v3-personal-signature]");
        const identitySignatureColumn = root.querySelector<HTMLElement>("[data-v3-personal-signature-column]");
        const saveData = (navigator as Navigator & { connection?: NetworkInformation }).connection?.saveData === true;
        let identityTimeline: gsap.core.Timeline | undefined;
        let identityFailed = false;
        const identityFrameCount = Number(identityVideo?.dataset.v3IdentityFrameCount ?? 0);
        const identityFramePath = (index: number) => `/assets/v3/identity-frames/frame-${String(index).padStart(4, "0")}.webp`;
        const identityFrames = identityVideo && identityFrameCount > 0
          ? Array.from({ length: identityFrameCount }, (_, index) => identityFramePath(index))
          : [];

        const showIdentityFinal = () => {
          if (!identityStage || !identityVideo || !identityFinal) return;
          identityFailed = true;
          identityTimeline?.scrollTrigger?.kill();
          identityTimeline?.kill();
          gsap.set(identityVideo, { autoAlpha: 0 });
          gsap.set(identityHead, { autoAlpha: 0 });
          gsap.set(identityFinal, { autoAlpha: 1 });
          if (identityCopy) gsap.set(identityCopy, { autoAlpha: 1, clearProps: "filter,transform" });
          if (identitySignature) gsap.set(identitySignature, { autoAlpha: 1, clearProps: "filter,transform" });
          if (identitySignatureColumn) gsap.set(identitySignatureColumn, { autoAlpha: 1, clearProps: "filter,transform" });
          identityStage.dataset.v3MediaFallback = "true";
          setWillChange([identityVideo, identityFinal], "");
        };

        const createIdentityScrub = () => {
          if (!identityStage || !identityVideo || !identityFinal || identityFailed || identityFrames.length === 0) {
            showIdentityFinal();
            return;
          }
          const state = { progress: 0, frame: 0 };
          let displayedFrame = 0;
          const slowFrame = Math.min(85, identityFrames.length - 1);
          const slowFrameProgress = slowFrame / Math.max(1, identityFrames.length - 1);
          const getFrameProgress = (progress: number) => {
            const bounded = Math.min(1, Math.max(0, progress));
            if (bounded <= slowFrameProgress) return bounded;
            const tailProgress = (bounded - slowFrameProgress) / (1 - slowFrameProgress);
            // Ease the final frames into the end of the scene so 0095–0105
            // remain visible instead of being compressed into one wheel tick.
            return slowFrameProgress + (1 - slowFrameProgress) * Math.pow(tailProgress, 0.65);
          };
          const syncIdentityFrame = () => {
            const nextFrame = Math.round(state.frame);
            if (nextFrame === displayedFrame || !identityFrames[nextFrame]) return;
            displayedFrame = nextFrame;
            identityVideo.src = identityFrames[nextFrame];
          };
          gsap.set(identityHead, { autoAlpha: 0 });
          gsap.set(identityVideo, { autoAlpha: 1 });
          gsap.set(identityFinal, { autoAlpha: 0 });
          if (identityCopy) gsap.set(identityCopy, { autoAlpha: 0, y: 24, filter: "blur(10px)" });
          if (identitySignature) gsap.set(identitySignature, { autoAlpha: 0, y: 18, filter: "blur(8px)" });
          if (identitySignatureColumn) gsap.set(identitySignatureColumn, { autoAlpha: 0 });
          identityTimeline = gsap.timeline({
            scrollTrigger: {
              trigger: identityStage,
              start: "top 72%",
              end: () => `+=${Math.max(2600, window.innerHeight * 3.2)}`,
              scrub: 1.05,
              invalidateOnRefresh: true,
              onEnter: () => setWillChange([identityVideo, identityFinal], "opacity"),
              onEnterBack: () => setWillChange([identityVideo, identityFinal], "opacity"),
              onLeave: () => setWillChange([identityVideo, identityFinal], ""),
              onLeaveBack: () => setWillChange([identityVideo, identityFinal], ""),
            },
          });
          identityTimeline.to(state, {
            progress: 1,
            duration: 1,
            ease: "none",
            onUpdate: () => {
              if (identityFailed) return;
              state.frame = (identityFrames.length - 1) * getFrameProgress(state.progress);
              syncIdentityFrame();
            },
          }, 0);
          if (identityCopy) {
            identityTimeline.fromTo(identityCopy,
              { autoAlpha: 0, y: 24, filter: "blur(10px)" },
              { autoAlpha: 1, y: 0, filter: "blur(0px)", duration: 0.52, ease: "power3.out" },
              0.42,
            );
          }
          identityTimeline.set(identityVideo, { autoAlpha: 1 }, 1);
          if (identitySignature) {
            identityTimeline.fromTo(identitySignature,
              { autoAlpha: 0, y: 18, filter: "blur(8px)" },
              { autoAlpha: 1, y: 0, filter: "blur(0px)", duration: 0.45, ease: "power2.out" },
              0.72,
            );
          }
          if (identitySignatureColumn) {
            identityTimeline.fromTo(identitySignatureColumn,
              { autoAlpha: 0 },
              { autoAlpha: 1, duration: 0.45, ease: "power2.out" },
              0.72,
            );
          }
        };

        if (identityVideo) {
          if (saveData || identityFrames.length === 0) {
            showIdentityFinal();
          } else {
            const preloadFrames = identityFrames.map((src) => {
              const frame = new Image();
              frame.src = src;
              return frame;
            });
            const onError = () => showIdentityFinal();
            identityVideo.addEventListener("error", onError, { once: true });
            const framesReady = Promise.all(preloadFrames.map((frame) => {
              if (frame.complete && frame.naturalWidth > 0) return Promise.resolve();
              return new Promise<void>((resolve) => {
                const settle = () => resolve();
                frame.addEventListener("load", settle, { once: true });
                frame.addEventListener("error", settle, { once: true });
                if (typeof frame.decode === "function") {
                  frame.decode().then(settle).catch(() => undefined);
                }
              });
            }));
            branchDisposers.push(() => {
              identityVideo.removeEventListener("error", onError);
              preloadFrames.forEach((frame) => { frame.src = ""; });
            });
            framesReady.then(() => {
              if (identityFailed || disposed) return;
              createIdentityScrub();
              ScrollTrigger.refresh();
            });
          }
        }

        const processSteps = root.querySelector<HTMLElement>("[data-v3-process-steps]");
        const processCards = Array.from(root.querySelectorAll<HTMLElement>("[data-v3-process-card]"));
        processCards.forEach((card, index) => {
          card.style.setProperty("--v3-process-index", String(index));
          const nextCard = processCards[index + 1];
          if (!nextCard) return;
          gsap.to(card, {
            scale: 0.965 - index * 0.006,
            autoAlpha: 0.52,
            ease: "none",
            scrollTrigger: {
              trigger: nextCard,
              start: "top 78%",
              end: "top 22%",
              scrub: true,
              invalidateOnRefresh: true,
              onEnter: () => setWillChange([card], "transform, opacity"),
              onEnterBack: () => setWillChange([card], "transform, opacity"),
              onLeave: () => setWillChange([card], ""),
              onLeaveBack: () => setWillChange([card], ""),
            },
          });
        });
        if (processSteps) {
          ScrollTrigger.create({
            trigger: processSteps,
            start: "top 72%",
            end: "bottom 24%",
            invalidateOnRefresh: true,
          });
        }

        const workPin = root.querySelector<HTMLElement>("[data-v3-work-pin]");
        const workViewport = root.querySelector<HTMLElement>("[data-v3-work-viewport]");
        const workTrack = root.querySelector<HTMLElement>("[data-v3-work-track]");
        if (workPin && workViewport && workTrack) {
          const travel = () => getHorizontalTravel(workTrack.scrollWidth, workViewport.clientWidth);
          gsap.to(workTrack, {
            x: () => -travel(),
            ease: "none",
            scrollTrigger: {
              trigger: workPin,
              start: "top top+=84",
              end: () => `+=${Math.max(1, travel())}`,
              pin: workPin,
              scrub: 0.75,
              invalidateOnRefresh: true,
              onEnter: () => setWillChange([workTrack], "transform"),
              onEnterBack: () => setWillChange([workTrack], "transform"),
              onLeave: () => setWillChange([workTrack], ""),
              onLeaveBack: () => setWillChange([workTrack], ""),
            },
          });
        }

        const restrainedRevealGroups = [
          ...root.querySelectorAll<HTMLElement>(".v3-services__list article"),
          ...root.querySelectorAll<HTMLElement>(".v3-pricing__grid .v3-price"),
        ];
        restrainedRevealGroups.forEach((item) => {
          gsap.fromTo(item, { autoAlpha: 0, y: 28 }, {
            autoAlpha: 1,
            y: 0,
            duration: 0.48,
            ease: "power2.out",
            scrollTrigger: { trigger: item, start: "top 88%", once: true },
            onStart: () => setWillChange([item], "transform, opacity"),
            onComplete: () => setWillChange([item], ""),
          });
        });

        return () => {
          branchDisposers.splice(0).forEach((dispose) => dispose());
          processCards.forEach((card) => card.style.removeProperty("--v3-process-index"));
          setWillChange([
            ...introElements,
            ...heroAnimated,
            ...capabilityLetters,
            ...processCards,
            ...restrainedRevealGroups,
            ...(workTrack ? [workTrack] : []),
          ], "");
          if (ticker) gsap.ticker.remove(ticker);
          if (lenis) {
            lenis.off("scroll", ScrollTrigger.update);
            lenis.destroy();
          }
          [identityHead, identityVideo, identityFinal].forEach((element) => {
            element?.style.removeProperty("opacity");
            element?.style.removeProperty("visibility");
          });
          if (identityStage) delete identityStage.dataset.v3MediaFallback;
          root.classList.remove("v3-motion-cinematic");
        };
      });
    }, root);

    if (enabled) {
      const heroImages = Array.from(root.querySelectorAll<HTMLImageElement>(".v3-hero img"));
      const mediaReady = heroImages.map((image) => waitForImage(image, disposers));
      mediaReady.push(document.fonts.ready.then(() => undefined));
      void Promise.allSettled(mediaReady).then(() => {
        if (!disposed) ScrollTrigger.refresh();
      });

      const onResize = () => {
        if (resizeTimer !== undefined) window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          if (!disposed) ScrollTrigger.refresh();
        }, 180);
      };
      window.addEventListener("resize", onResize, { passive: true });
      disposers.push(() => window.removeEventListener("resize", onResize));
    }

    return () => {
      disposed = true;
      if (resizeTimer !== undefined) window.clearTimeout(resizeTimer);
      disposers.splice(0).forEach((dispose) => dispose());
      media.revert();
      context.revert();
      root.classList.remove("v3-motion-cinematic");
      delete root.dataset.v3Motion;
    };
  }

  const root = document.querySelector<HTMLElement>("body.v3");
  if (root && root.dataset.v3MotionInitialized !== "true") {
    root.dataset.v3MotionInitialized = "true";
    let cleanup = initV3Motion(root);
    const rebuild = () => {
      cleanup();
      cleanup = initV3Motion(root);
    };
    const onMotion = (event: Event) => {
      motionOverride = readMotionEvent((event as CustomEvent).detail, motionOverride ?? true);
      rebuild();
    };
    const onPageHide = () => cleanup();
    const onPageShow = (event: PageTransitionEvent) => {
      if (event.persisted) rebuild();
    };
    const onBeforeSwap = () => {
      cleanup();
      delete root.dataset.v3MotionInitialized;
      window.removeEventListener("v3:motion", onMotion);
      window.removeEventListener("pagehide", onPageHide);
      window.removeEventListener("pageshow", onPageShow);
    };

    window.addEventListener("v3:motion", onMotion);
    window.addEventListener("pagehide", onPageHide);
    window.addEventListener("pageshow", onPageShow);
    document.addEventListener("astro:before-swap", onBeforeSwap, { once: true });
  }
</script>
