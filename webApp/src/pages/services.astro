---
import "@fontsource-variable/oswald";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/v3/Navigation";
import V3Motion from "../components/v3/V3Motion.astro";
import Footer from "../components/v3/Footer.astro";
import { pricingGroups } from "../data/v3";
import "../styles/v3.css";

const title = "Услуги и цены на разработку сайтов | Сергей Крюков";
const description = "Форматы и ориентировочная стоимость разработки сайтов, веб-сервисов, интерактивных инструментов и продвижения.";
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${new URL("/services/", Astro.site ?? Astro.url.origin)}#service`,
      name: "Разработка сайтов и веб-сервисов",
      description,
      provider: { "@id": `${new URL("/", Astro.site ?? Astro.url.origin)}#professional` },
      areaServed: { "@type": "Country", name: "Россия" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Главная", item: new URL("/", Astro.site ?? Astro.url.origin).toString() },
        { "@type": "ListItem", position: 2, name: "Услуги и цены", item: new URL("/services/", Astro.site ?? Astro.url.origin).toString() },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} canonical="/services/" variant="cinematic">
  <Navigation slot="before-main" client:load />

  <section id="pricing" class="v3-pricing v3-section" aria-labelledby="v3-pricing-title">
    <div class="v3-shell">
      <div class="v3-section-heading v3-section-heading--split">
        <div><p class="v3-kicker">Рабочие ориентиры</p><h1 id="v3-pricing-title">Стоимость зависит от масштаба</h1></div>
        <p>Это стартовые ориентиры, а не публичная оферта. Финальная оценка появляется после уточнения состава и сроков.</p>
      </div>
      <div class="v3-pricing__groups">
        {pricingGroups.map((group) => (
          <section class="v3-pricing__group" aria-labelledby={`v3-pricing-${group.id}-title`}>
            <h2 id={`v3-pricing-${group.id}-title`}>{group.title}</h2>
            <div class="v3-pricing__grid">
              {group.offers.map((offer) => (
                <article class:list={["v3-price", offer.featured && "v3-price--featured"]} data-offer-id={offer.id}>
                  <div><p>{offer.title}</p>{offer.featured && <span>Частый выбор</span>}</div>
                  <strong>{offer.priceLabel}</strong>
                  <p>{offer.summary}</p>
                  <ul>{offer.includes.map((item) => <li>{item}</li>)}</ul>
                  <p class="v3-price__boundary">{offer.boundary}</p>
                  <a class="v3-button v3-button--quiet" href="/messengers/" data-v3-open-calculator>Обсудить состав</a>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />

  <Footer slot="after-main" />
  <V3Motion slot="after-main" />
</BaseLayout>
