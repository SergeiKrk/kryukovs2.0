---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/v3.css";
---

<BaseLayout title="Страница не найдена — Сергей Крюков" description="Запрошенная страница не найдена." noindex={true} variant="cinematic">
  <section class="v3-section" aria-labelledby="not-found-title">
    <div class="v3-shell">
      <div class="v3-section-heading">
        <p class="v3-kicker">Ошибка 404</p>
        <h1 id="not-found-title">Такой страницы нет</h1>
        <p class="v3-section-heading__copy">Возможно, ссылка устарела. Вернитесь на главную и продолжите знакомство с проектами.</p>
        <a class="v3-button v3-button--primary" href="/">На главную <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
